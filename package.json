{
  "name": "game",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@mui/material": "^5.15.1",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "express": "^4.19.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "typescript": "^4.9.5",
    "vite": "^5.2.8",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "devDependencies": {
    "gh-pages": "^6.1.1"
  },
  "scripts": {
    "api": "node server.js",
    "serve": "npm run build && PORT=8888 node server.js",
    "docker:build": "docker build -t demo .",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "vite",
    "build": "tsc && vite build",
    "deploy:clean": "npm run docker -- kill ${NAME}; npm run docker -- rm ${NAME} || true",
    "deploy:clean-images": "npm run ssh -- 'docker rmi $(docker images -f \"dangling=true\" -q)' || true",
    "deploy:build": "npm run docker -- build -t ${NAME}:v1 .",
    "deploy:docker": "npm run deploy:build && npm run cleanStart && npm run deploy:clean-images && npm run logs",
    "cleanStart": "npm run deploy:clean && npm run docker -- run --name ${NAME} --restart=always -p 80:4001 -d ${NAME}:v1",
    "docker": "docker -H ssh://ubuntu@${SERVER}",
    "logs": "npm run docker -- logs ${NAME} -f --tail ${LOGS:-10}",
    "ssh": "ssh ubuntu@${SERVER}",
    "preview": "vite preview"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
